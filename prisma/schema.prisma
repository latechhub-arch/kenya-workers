generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  NATIONAL_GOVERNMENT
  COUNTY_GOVERNMENT
  MINISTRY
  DEPARTMENT
  AGENCY
  STATE_CORPORATION
  OTHER
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum PersonStatus {
  ACTIVE
  INACTIVE
  DECEASED
}

enum EmploymentType {
  PERMANENT
  PENSIONABLE
  CONTRACT
  TEMPORARY
  CASUAL
  INTERNSHIP
  ATTACHMENT
  SECONDMENT
  OTHER
}

enum PayComponentType {
  EARNING
  DEDUCTION
}

enum PayComponentFrequency {
  MONTHLY
  ONE_OFF
}

enum PayslipStatus {
  ISSUED
  SUPERSEDED
}

enum EmploymentStatus {
  ACTIVE
  SUSPENDED
  ON_LEAVE
  ENDED
  RETIRED
  TERMINATED
  RESIGNED
  DISMISSED
  DECEASED
}

enum JobFrameworkType {
  MILITARY_RANK
  POLICE_RANK
  CIVIL_SERVICE_GRADE
  OTHER
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  personId     String? @unique @db.Uuid
  email        String  @unique @db.VarChar(320)
  fullName     String  @db.VarChar(255)
  passwordHash String  @db.VarChar(255)
  isActive     Boolean @default(true)

  person                            Person?                 @relation(fields: [personId], references: [id], onDelete: SetNull)
  roleAssignments                   UserRole[]
  sessions                          AuthSession[]
  auditEvents                       AuditEvent[]
  createdEmployeeAccountInvitations EmployeeAccountInvite[] @relation("EmployeeAccountInviteCreator")
  employeeBudgetProfile             EmployeeBudgetProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(255)
  description String? @db.VarChar(1000)

  userAssignments UserRole[]
  permissions     RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(100)
  description String @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @db.Uuid
  roleId         String  @db.Uuid
  organizationId String? @db.Uuid

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([organizationId])
  @@map("user_roles")
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @db.Uuid
  organizationId String?  @db.Uuid
  action         String   @db.VarChar(150)
  entityType     String   @db.VarChar(100)
  entityId       String?  @db.VarChar(100)
  metadata       Json?    @db.JsonB
  ipAddress      String?  @db.VarChar(64)
  userAgent      String?  @db.VarChar(500)
  occurredAt     DateTime @default(now())

  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

model Organization {
  id     String             @id @default(uuid()) @db.Uuid
  code   String             @unique @db.VarChar(50)
  name   String             @db.VarChar(255)
  type   OrganizationType
  status OrganizationStatus @default(ACTIVE)

  parentId String?        @db.Uuid
  parent   Organization?  @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children Organization[] @relation("OrganizationHierarchy")

  departments         Department[]
  stations            Station[]
  employments         Employment[]
  postings            EmploymentPosting[]
  jobFrameworks       JobFramework[]
  positions           JobPosition[]
  userRoleAssignments UserRole[]
  personScopes        PersonOrganizationScope[]
  auditEvents         AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([type])
  @@index([status])
  @@map("organizations")
}

model Department {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  code String @db.VarChar(50)
  name String @db.VarChar(255)

  organization Organization        @relation(fields: [organizationId], references: [id])
  stations     Station[]
  employments  Employment[]
  postings     EmploymentPosting[]
  positions    JobPosition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model Station {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  departmentId   String? @db.Uuid

  code String @db.VarChar(50)
  name String @db.VarChar(255)

  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  geofenceRadius Decimal? @db.Decimal(10, 2)

  organization      Organization        @relation(fields: [organizationId], references: [id])
  department        Department?         @relation(fields: [departmentId], references: [id])
  employments       Employment[]
  postings          EmploymentPosting[]
  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([departmentId])
  @@map("stations")
}

// Classification systems are scoped to an organization so military ranks,
// police ranks, and civil-service grades can evolve independently.
model JobFramework {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  code           String           @db.VarChar(50)
  name           String           @db.VarChar(255)
  type           JobFrameworkType
  description    String?          @db.VarChar(1000)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  levels             JobLevel[]
  levelAliases       JobLevelAlias[]
  positions          JobPosition[]
  compensationScales CompensationScale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@map("job_frameworks")
}

model JobLevel {
  id          String @id @default(uuid()) @db.Uuid
  frameworkId String @db.Uuid
  code        String @db.VarChar(50)
  title       String @db.VarChar(255)
  levelOrder  Int

  framework         JobFramework       @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  aliases           JobLevelAlias[]
  positions         JobPosition[]
  compensationSteps CompensationStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([frameworkId, code])
  @@unique([frameworkId, levelOrder])
  @@map("job_levels")
}

model JobLevelAlias {
  id          String  @id @default(uuid()) @db.Uuid
  frameworkId String  @db.Uuid
  jobLevelId  String  @db.Uuid
  scheme      String  @db.VarChar(50)
  code        String  @db.VarChar(50)
  title       String? @db.VarChar(255)
  source      String? @db.VarChar(1000)

  framework JobFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  jobLevel  JobLevel     @relation(fields: [jobLevelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([frameworkId, scheme, code])
  @@index([jobLevelId])
  @@map("job_level_aliases")
}

model CompensationScale {
  id            String    @id @default(uuid()) @db.Uuid
  frameworkId   String    @db.Uuid
  code          String    @db.VarChar(50)
  name          String    @db.VarChar(255)
  currency      String    @default("KES") @db.VarChar(3)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  isProvisional Boolean   @default(false)
  source        String?   @db.VarChar(1000)

  framework JobFramework       @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  steps     CompensationStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([frameworkId, code])
  @@index([frameworkId, effectiveFrom])
  @@map("compensation_scales")
}

model CompensationStep {
  id                  String  @id @default(uuid()) @db.Uuid
  compensationScaleId String  @db.Uuid
  jobLevelId          String  @db.Uuid
  stepNumber          Int
  basicSalary         Decimal @db.Decimal(12, 2)

  compensationScale     CompensationScale                  @relation(fields: [compensationScaleId], references: [id], onDelete: Cascade)
  jobLevel              JobLevel                           @relation(fields: [jobLevelId], references: [id], onDelete: Restrict)
  employmentAssignments EmploymentCompensationAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([compensationScaleId, jobLevelId, stepNumber])
  @@index([jobLevelId])
  @@map("compensation_steps")
}

model EmploymentCompensationAssignment {
  id                 String    @id @default(uuid()) @db.Uuid
  employmentId       String    @db.Uuid
  compensationStepId String    @db.Uuid
  effectiveFrom      DateTime  @db.Date
  effectiveTo        DateTime? @db.Date
  reason             String    @db.VarChar(500)

  employment       Employment       @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  compensationStep CompensationStep @relation(fields: [compensationStepId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employmentId, effectiveFrom])
  @@index([compensationStepId, effectiveTo])
  @@map("employment_compensation_assignments")
}

// Effective-dated payroll inputs. Changes create a new dated component version;
// issued payslips keep their own immutable line-item snapshots.
model EmploymentPayComponent {
  id            String                @id @default(uuid()) @db.Uuid
  employmentId  String                @db.Uuid
  code          String                @db.VarChar(50)
  title         String                @db.VarChar(255)
  type          PayComponentType
  frequency     PayComponentFrequency @default(MONTHLY)
  currency      String                @default("KES") @db.VarChar(3)
  amount        Decimal               @db.Decimal(12, 2)
  balance       Decimal?              @db.Decimal(12, 2)
  effectiveFrom DateTime              @db.Date
  effectiveTo   DateTime?             @db.Date
  note          String?               @db.VarChar(500)

  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employmentId, code, effectiveFrom])
  @@index([employmentId, effectiveFrom, effectiveTo])
  @@map("employment_pay_components")
}

model Payslip {
  id               String        @id @default(uuid()) @db.Uuid
  employmentId     String        @db.Uuid
  periodYear       Int
  periodMonth      Int
  version          Int           @default(1)
  currency         String        @default("KES") @db.VarChar(3)
  status           PayslipStatus @default(ISSUED)
  isProvisional    Boolean       @default(false)
  earningsTotal    Decimal       @db.Decimal(12, 2)
  deductionsTotal  Decimal       @db.Decimal(12, 2)
  netPay           Decimal       @db.Decimal(12, 2)
  correctionReason String?       @db.VarChar(500)
  issuedAt         DateTime      @default(now())

  employment Employment    @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  lines      PayslipLine[]

  createdAt DateTime @default(now())

  @@unique([employmentId, periodYear, periodMonth, version])
  @@index([employmentId, periodYear, periodMonth, status])
  @@map("payslips")
}

model PayslipLine {
  id           String           @id @default(uuid()) @db.Uuid
  payslipId    String           @db.Uuid
  code         String           @db.VarChar(50)
  title        String           @db.VarChar(255)
  type         PayComponentType
  amount       Decimal          @db.Decimal(12, 2)
  balance      Decimal?         @db.Decimal(12, 2)
  displayOrder Int              @default(0)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([payslipId, displayOrder])
  @@map("payslip_lines")
}

// Private employee-entered budget inputs. No staff or payroll admin relation exposes these records.
model EmployeeBudgetProfile {
  userId          String               @id @db.Uuid
  monthlyTakeHome Decimal?             @db.Decimal(12, 2)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           EmployeeBudgetItem[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("employee_budget_profiles")
}

model EmployeeBudgetItem {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @db.Uuid
  category           String                @db.VarChar(30)
  title              String                @db.VarChar(120)
  monthlyAmount      Decimal               @db.Decimal(12, 2)
  outstandingBalance Decimal?              @db.Decimal(12, 2)
  profile            EmployeeBudgetProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([userId, category])
  @@map("employee_budget_items")
}

model JobPosition {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @db.Uuid
  departmentId    String? @db.Uuid
  frameworkId     String  @db.Uuid
  levelId         String  @db.Uuid
  code            String  @db.VarChar(50)
  title           String  @db.VarChar(255)
  authorizedSlots Int

  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department   Department?                    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  framework    JobFramework                   @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  level        JobLevel                       @relation(fields: [levelId], references: [id], onDelete: Restrict)
  assignments  EmploymentPositionAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([departmentId])
  @@index([frameworkId, levelId])
  @@map("job_positions")
}

model Person {
  id           String @id @default(uuid()) @db.Uuid
  personNumber String @unique @db.VarChar(50)

  firstName  String  @db.VarChar(100)
  middleName String? @db.VarChar(100)
  lastName   String  @db.VarChar(100)

  dateOfBirth DateTime? @db.Date

  nationalIdHash String? @unique @db.VarChar(128)
  kraPinHash     String? @unique @db.VarChar(128)

  status PersonStatus @default(ACTIVE)

  employments        Employment[]
  organizationScopes PersonOrganizationScope[]
  userAccount        User?
  accountInvitations EmployeeAccountInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
  @@index([status])
  @@map("persons")
}

model EmployeeAccountInvite {
  id              String    @id @default(uuid()) @db.Uuid
  personId        String    @db.Uuid
  tokenHash       String    @unique @db.VarChar(64)
  expiresAt       DateTime
  usedAt          DateTime?
  createdByUserId String    @db.Uuid

  person    Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdBy User   @relation("EmployeeAccountInviteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([personId, expiresAt])
  @@map("employee_account_invites")
}

model PersonOrganizationScope {
  personId       String @db.Uuid
  organizationId String @db.Uuid

  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([personId, organizationId])
  @@map("person_organization_scopes")
}

model Employment {
  id               String @id @default(uuid()) @db.Uuid
  employmentNumber String @unique @db.VarChar(50)

  personId       String  @db.Uuid
  organizationId String  @db.Uuid
  departmentId   String? @db.Uuid
  stationId      String? @db.Uuid

  employmentType EmploymentType
  status         EmploymentStatus @default(ACTIVE)

  appointmentDate DateTime? @db.Date
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date

  person                  Person                             @relation(fields: [personId], references: [id])
  organization            Organization                       @relation(fields: [organizationId], references: [id])
  department              Department?                        @relation(fields: [departmentId], references: [id])
  station                 Station?                           @relation(fields: [stationId], references: [id])
  postings                EmploymentPosting[]
  positionAssignments     EmploymentPositionAssignment[]
  compensationAssignments EmploymentCompensationAssignment[]
  payComponents           EmploymentPayComponent[]
  payslips                Payslip[]
  attendanceRecords       AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([stationId])
  @@index([status])
  @@index([employmentType])
  @@index([startDate])
  @@map("employments")
}

model AttendanceRecord {
  id                   String   @id @default(uuid()) @db.Uuid
  employmentId         String   @db.Uuid
  stationId            String   @db.Uuid
  workDate             DateTime @db.Date
  checkInAt            DateTime @default(now())
  locationCapturedAt   DateTime
  latitude             Decimal  @db.Decimal(10, 7)
  longitude            Decimal  @db.Decimal(10, 7)
  accuracyMeters       Decimal  @db.Decimal(8, 2)
  distanceMeters       Decimal  @db.Decimal(10, 2)
  mockLocationReported Boolean?

  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  station    Station    @relation(fields: [stationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([employmentId, workDate])
  @@index([stationId, workDate])
  @@map("attendance_records")
}

model EmploymentPositionAssignment {
  id           String @id @default(uuid()) @db.Uuid
  employmentId String @db.Uuid
  positionId   String @db.Uuid

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  reason        String    @db.VarChar(500)

  employment Employment  @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  position   JobPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employmentId, effectiveFrom])
  @@index([positionId, effectiveTo])
  @@map("employment_position_assignments")
}

model EmploymentPosting {
  id             String  @id @default(uuid()) @db.Uuid
  employmentId   String  @db.Uuid
  organizationId String  @db.Uuid
  departmentId   String? @db.Uuid
  stationId      String? @db.Uuid

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  reason        String    @db.VarChar(500)

  employment   Employment   @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  station      Station?     @relation(fields: [stationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employmentId, effectiveFrom])
  @@index([organizationId])
  @@index([departmentId])
  @@index([stationId])
  @@map("employment_postings")
}
